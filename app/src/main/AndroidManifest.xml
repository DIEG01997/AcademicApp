<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AcademicApp"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        tools:targetApi="31">

        <!-- Establecer SplashActivity como la actividad principal para el primer lanzamiento -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RegisterActivity configurada como actividad secundaria -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false" />

        <!-- LoginActivity configurada como actividad secundaria -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- MainActivity configurada como actividad secundaria -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <activity
            android:name=".activities.PerfilActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AsignaturasActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UnidadesActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UnidadNotasActivity"
            android:exported="false" />

        <activity
            android:name=".activities.NotasActivity"
            android:exported="false" />

        <activity
            android:name=".activities.EstadisticasActivity"
            android:exported="false" />

        <activity
            android:name=".activities.CrearNotaActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ChatCursoActivity"
            android:exported="false" />

    </application>

</manifest>
