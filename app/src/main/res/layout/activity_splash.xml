<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_wave"
    android:padding="28dp">

    <ImageView
        android:id="@+id/imgSplashLogo"
        android:layout_width="280dp"
        android:layout_height="250dp"
        android:contentDescription="Logo AcademicApp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_academic_logo"
        app:layout_constraintBottom_toTopOf="@id/txtSplashTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/txtSplashTagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tu rendimiento, tu progreso, tu futuro."
        android:textColor="@color/textColorSecondary"
        android:textSize="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgSplashLogo" />

</androidx.constraintlayout.widget.ConstraintLayout>
